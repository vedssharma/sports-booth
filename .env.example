# Required: Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Get from https://the-odds-api.com/ (free tier available)
# Required for live betting data (demo mode uses mock odds)
ODDS_API_KEY=your_odds_api_key_here

# Optional: models. CLAUDE_MODEL covers big moments (runs, crunch time, finals);
# CLAUDE_MODEL_FAST covers routine events (quarter starts, live updates)
# CLAUDE_MODEL=claude-sonnet-4-6
# CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001

# Optional: spending controls
# Rolling one-hour budget in USD (default 5, 0 = unlimited). At 75% the booth switches to
# the cheap model and skips routine updates; at 100% only final scores get commentary.
# BOOTH_BUDGET_USD_PER_HOUR=5
# Hard cap on a single agent run in USD (default 0.50)
# BOOTH_MAX_USD_PER_AGENT=0.50

# Optional: where the dashboard listens. Defaults to loopback only (127.0.0.1:8000).
# Binding any other address (e.g. 0.0.0.0) requires BOOTH_AUTH_TOKEN.
# BOOTH_HOST=127.0.0.1
# BOOTH_PORT=8000
# Shared secret for the dashboard, WebSocket and /health. Generate one with:
#   python -c 'import secrets; print(secrets.token_urlsafe(24))'
# Then open http://localhost:8000/?token=<value> once; the browser remembers it.
# BOOTH_AUTH_TOKEN=
# Set to 1 only if something else already restricts access (a reverse proxy, a loopback-only
# port mapping) and you really want to listen on a network address without a token.
# BOOTH_ALLOW_INSECURE=0
# Extra browser Origins allowed to open the WebSocket (comma-separated), e.g. behind a reverse
# proxy that serves the dashboard on another hostname. Same-origin is always allowed.
# BOOTH_ALLOWED_ORIGINS=https://booth.example.com

# Optional: logging. Level: debug|info|warning|error. Format: text (human) | json (one object per line)
# BOOTH_LOG_LEVEL=info
# BOOTH_LOG_FORMAT=text

# Optional: storage locations and tuning
# BOOTH_HISTORY_DB=data/history.db
# BOOTH_ODDS_DB=data/odds.db
# BOOTH_ODDS_TTL=60
